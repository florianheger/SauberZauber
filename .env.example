POSTGRES_DB=sauberzauber
POSTGRES_USER=sauberzauber
POSTGRES_PASSWORD=change-me

# Users of the household (comma separated, max. two)
APP_USERS=alex,sam
# WebAuthn relying party: the domain, and the exact origin the app is opened from.
# In production behind the reverse proxy e.g. APP_RP_ID=sauberzauber.example.de, APP_ORIGIN=https://sauberzauber.example.de
APP_RP_ID=localhost
APP_ORIGIN=http://localhost:8080
# Host port of the app (the reverse proxy forwards to it)
APP_PORT=8080
# Set to a user name to get a new enrollment link on the next start (e.g. lost passkey)
APP_REENROLL=

# Push notifications (optional; off while the keys are empty). Generate the key pair once with
#   npx web-push generate-vapid-keys
# and set a contact the push services can reach (mailto: or https:). Changing the keys later
# invalidates all subscriptions, so everyone has to turn notifications on again.
APP_VAPID_PUBLIC_KEY=
APP_VAPID_PRIVATE_KEY=
APP_VAPID_SUBJECT=mailto:admin@example.de
