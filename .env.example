POSTGRES_DB=sauberzauber
POSTGRES_USER=sauberzauber
POSTGRES_PASSWORD=change-me

# Users of the household (comma separated, max. two)
APP_USERS=alex,sam
# WebAuthn relying party: the domain, and the exact origin the app is opened from.
# In production behind the reverse proxy e.g. APP_RP_ID=sauberzauber.example.de, APP_ORIGIN=https://sauberzauber.example.de
APP_RP_ID=localhost
APP_ORIGIN=http://localhost:8080
# Host port of the app (the reverse proxy forwards to it)
APP_PORT=8080
# Set to a user name to get a new enrollment link on the next start (e.g. lost passkey)
APP_REENROLL=
